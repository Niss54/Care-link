# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# CareLink Clinical Portal – Environment Config
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to git
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# ■■ Supabase (Required for Auth + Database) ■■
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
# ■■ Google Gemini AI (Required for AI Triage) ■■
GEMINI_API_KEY=your-gemini-api-key-here
# ■■ App Config ■■
VITE_APP_NAME=CareLink
VITE_APP_URL=http://localhost:3000
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# HOW TO GET SUPABASE KEYS:
# 1. Go to https://supabase.com/dashboard
# 2. Create project named "carelink"
# 3. Settings → API → copy Project URL and anon key
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# HOW TO GET GEMINI KEY:
# 1. Go to https://aistudio.google.com/app/apikey
# 2. Create API key
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
